{
  "name": "khuruj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Khuruj (خروج) — university digital student out-pass and gate-management system",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
