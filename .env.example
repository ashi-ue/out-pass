# ---------------------------------------------------------------------------
# Khuruj (خروج) — environment template
# Copy to `.env.local` (frontend) and set the same names in your backend host.
# NEVER commit a real secret key. `.env*` is gitignored.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) — publishable key only, safe to ship to the browser ---
# Only variables prefixed with VITE_ are exposed to client code.
VITE_SUPABASE_URL=https://nvjhyzqbfmnzohlvgdca.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend / Edge Functions — SECRET, server-side only ---
# Do not put a VITE_ prefix on these. Never import them in src/.
SUPABASE_URL=https://nvjhyzqbfmnzohlvgdca.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://nvjhyzqbfmnzohlvgdca.supabase.co/auth/v1/.well-known/jwks.json

# --- Local tooling ---
# Project ref (subdomain) used by `npm run gen:types`.
SUPABASE_PROJECT_ID=nvjhyzqbfmnzohlvgdca

# Campus timezone for display; the database stores/compares in UTC.
VITE_CAMPUS_TZ=Asia/Kolkata
